# =============================================================================
# EstateMaster - environment configuration
# Copy to .env (never commit it). In production set these in your host's secret manager.
# Lines marked REQUIRED(prod) make the server refuse to start in production when missing.
# =============================================================================

# ----------------------------------------------------------------------------- core
NODE_ENV=development
PORT=3000
# Public HTTPS address of this server (used for CORS and links inside e-mails).   REQUIRED(prod)
APP_URL=http://localhost:3000
# Extra browser origins allowed to call the API (comma separated). The Android app origins
# (https://localhost, capacitor://localhost) are always allowed. Never "*".
CORS_ORIGINS=
# Number of reverse proxies in front of the server (Cloud Run / nginx / Render = 1). Needed for correct client IPs
# in rate limiting and webhook IP allow-lists.
TRUST_PROXY_HOPS=1
# Secret (>= 32 random chars) that signs the expiring receipt/statement links sent in e-mails.   REQUIRED(prod)
#   generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LINK_SIGNING_SECRET=
# Session lifetime: idle timeout and absolute maximum.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# ----------------------------------------------------------------------------- data store
# Production uses Firestore through the Admin SDK (the browser never talks to Firestore).
#   DATA_STORE=firestore  -> Firebase Admin / Firestore      (default in production)
#   DATA_STORE=memory     -> in-memory, development & tests only (refused in production)
DATA_STORE=memory
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
# Service-account JSON, either raw JSON or base64 of the JSON. Alternatively use GOOGLE_APPLICATION_CREDENTIALS
# (path to the key file) or run on Cloud Run with a service account attached.
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
# Development only: ENABLE_DEMO_SEED=true creates sample accounts with RANDOM one-time passwords printed to the log.
ENABLE_DEMO_SEED=false

# ----------------------------------------------------------------------------- platform (EstateMaster as a business)
# Comma-separated landlord e-mails allowed to see platform-level bank diagnostics (balances, upstream errors).
PLATFORM_ADMIN_EMAILS=
# Annual landlord licence in KES. The server decides the amount; clients cannot change it.
PLATFORM_SUBSCRIPTION_AMOUNT=20000
PLATFORM_ACCOUNT_NAME=EstateMaster Kenya
# Where landlords can pay the licence (shown in the app together with their personal SUB-XXXXXXXX reference).
PLATFORM_EQUITY_PAYBILL=
PLATFORM_KCB_PAYBILL=
PLATFORM_COOP_ACCOUNT=
PLATFORM_MPESA_PHONE=

# ----------------------------------------------------------------------------- banks (shared)
# sandbox | production  (selects default base URLs)
BANKS_ENVIRONMENT=sandbox
BANK_HTTP_TIMEOUT_MS=10000
# DEVELOPMENT ONLY. Accepts bank webhooks without a signature so you can test with curl. Ignored (and the server
# refuses to start) in production.
BANK_WEBHOOKS_ALLOW_UNSIGNED_DEV=false

# ---- Equity Bank - Jenga (https://developer.jengaapi.io)
# OAuth: Authorization = Basic <JENGA_API_KEY>, body username=<MERCHANT_CODE> password=<CONSUMER_SECRET>
JENGA_MERCHANT_CODE=
JENGA_CONSUMER_SECRET=
JENGA_API_KEY=
JENGA_ACCOUNT_NUMBER=
JENGA_COUNTRY_CODE=KE
# RSA private key (PEM, "\n" escaped or base64) used to sign Jenga requests that require a signature.
JENGA_PRIVATE_KEY_PEM=
# Optional overrides - confirm against your Jenga onboarding pack:
JENGA_BASE_URL=
JENGA_TOKEN_PATH=
JENGA_BALANCE_PATH=
JENGA_MINI_STATEMENT_PATH=
JENGA_TXN_QUERY_PATH=
# IPN authenticity - set at least ONE of: HMAC secret, RSA public key, or Basic credentials.
# Without any of them the endpoint answers 503 and posts nothing (fail closed).
JENGA_WEBHOOK_HMAC_SECRET=
JENGA_WEBHOOK_HMAC_HEADER=x-jenga-signature
JENGA_WEBHOOK_HMAC_ENCODING=hex
JENGA_WEBHOOK_PUBLIC_KEY=
JENGA_WEBHOOK_SIGNATURE_HEADER=signature
JENGA_WEBHOOK_BASIC_USER=
JENGA_WEBHOOK_BASIC_PASS=
# Optional extra layer: only accept calls from these IPs / CIDRs (comma separated)
JENGA_WEBHOOK_IP_ALLOWLIST=
JENGA_WEBHOOK_TIMESTAMP_HEADER=
JENGA_WEBHOOK_MAX_SKEW_SECONDS=600

# ---- KCB - Buni (https://buni.kcbgroup.com)
KCB_APP_KEY=
KCB_APP_SECRET=
KCB_ACCOUNT_NUMBER=
KCB_BASE_URL=
KCB_TOKEN_PATH=
KCB_BALANCE_PATH=
KCB_TXN_QUERY_PATH=
KCB_WEBHOOK_HMAC_SECRET=
KCB_WEBHOOK_HMAC_HEADER=signature
KCB_WEBHOOK_HMAC_ENCODING=hex
KCB_WEBHOOK_PUBLIC_KEY=
KCB_WEBHOOK_SIGNATURE_HEADER=signature
KCB_WEBHOOK_BASIC_USER=
KCB_WEBHOOK_BASIC_PASS=
KCB_WEBHOOK_IP_ALLOWLIST=
KCB_WEBHOOK_TIMESTAMP_HEADER=
KCB_WEBHOOK_MAX_SKEW_SECONDS=600

# ---- Co-operative Bank - Co-op Open API (https://developer.co-opbank.co.ke)
COOP_CONSUMER_KEY=
COOP_CONSUMER_SECRET=
COOP_ACCOUNT_NUMBER=
COOP_BASE_URL=
COOP_TOKEN_PATH=
COOP_BALANCE_PATH=
COOP_TXN_QUERY_PATH=
COOP_ACCOUNT_TRANSACTIONS_PATH=
COOP_WEBHOOK_HMAC_SECRET=
COOP_WEBHOOK_HMAC_HEADER=x-coop-signature
COOP_WEBHOOK_HMAC_ENCODING=hex
COOP_WEBHOOK_PUBLIC_KEY=
COOP_WEBHOOK_SIGNATURE_HEADER=x-coop-signature
COOP_WEBHOOK_BASIC_USER=
COOP_WEBHOOK_BASIC_PASS=
COOP_WEBHOOK_IP_ALLOWLIST=
COOP_WEBHOOK_TIMESTAMP_HEADER=
COOP_WEBHOOK_MAX_SKEW_SECONDS=600

# ---- PesaLink (IPSL) - credits arrive via the receiving bank or an aggregator callback
PESALINK_WEBHOOK_HMAC_SECRET=
PESALINK_WEBHOOK_HMAC_HEADER=x-pesalink-signature
PESALINK_WEBHOOK_HMAC_ENCODING=hex
PESALINK_WEBHOOK_PUBLIC_KEY=
PESALINK_WEBHOOK_SIGNATURE_HEADER=x-pesalink-signature
PESALINK_WEBHOOK_BASIC_USER=
PESALINK_WEBHOOK_BASIC_PASS=
PESALINK_WEBHOOK_IP_ALLOWLIST=
PESALINK_WEBHOOK_TIMESTAMP_HEADER=
PESALINK_WEBHOOK_MAX_SKEW_SECONDS=600

# ----------------------------------------------------------------------------- M-Pesa (Safaricom Daraja)
# Credentials live ONLY here (never in code or the browser).
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Till / Paybill that receives the money (defaults to the shortcode)
MPESA_PARTYB=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Random string (>= 16 chars) that becomes part of the callback URL path, e.g. /api/mpesa/callback/<secret>.
# Safaricom does not sign callbacks, so this secret path plus an STK Query confirmation is what authenticates them.
# REQUIRED(prod) when MPESA_CONSUMER_KEY is set.
MPESA_CALLBACK_SECRET=
# Public HTTPS base used to build callback URLs (defaults to APP_URL)
MPESA_CALLBACK_BASE_URL=

# ----------------------------------------------------------------------------- AI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ----------------------------------------------------------------------------- e-mail delivery (pick one provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EstateMaster Kenya" <notifications@estatemaster.co.ke>
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
